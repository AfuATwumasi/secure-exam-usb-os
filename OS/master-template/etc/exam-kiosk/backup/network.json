{
  "mode": "restricted",
  "connection": {
    "allow_wifi": true,
    "allow_ethernet": true,
    "allow_manual_configuration": false
  },
  "filtering": {
    "enable_domain_filtering": true,
    "allow_dns": true,
    "allow_http": true,
    "allow_https": true,
    "block_other_traffic": false
  },
  "allowed_domains": [
    "example.com"
  ],
  "allowed_ports": [
    53,
    80,
    443
  ],
  "connectivity_test": {
    "enabled": true,
    "test_host": "example.com",
    "timeout_seconds": 20
  }
}
